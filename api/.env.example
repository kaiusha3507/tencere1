# Tencere API sunucusu — isteğe bağlı. Bu dosyayı "api/.env" adıyla kopyalayın.
# GİZLİ ANAHTARLAR YALNIZCA BURADA DURUR; mobil uygulamanın içine asla yazılmaz.

# Sunucu
PORT=8787
HOST=0.0.0.0

# ---------- AI (isteğe bağlı) ----------
# none | openai-compatible | anthropic
AI_PROVIDER=none
AI_API_KEY=
# openai-compatible için temel adres. Örnekler:
#   OpenAI:  https://api.openai.com/v1
#   Ollama (bilgisayarınızda ücretsiz, anahtarsız): http://localhost:11434/v1
AI_BASE_URL=
# Kullanılacak model adı (sağlayıcının belgelerinde yazan ad). Örnek (Anthropic): claude-haiku-5-5
AI_MODEL=
AI_TIMEOUT_MS=15000

# ---------- Migros ----------
# off     : sunucu perakende verisi sunmaz (uygulama kendi örnek kataloğunu kullanır) — varsayılan
# demo    : sunucu örnek kataloğu sunar (yalnızca test amaçlı, "demo" etiketli)
# partner : yetkili Migros entegrasyonu — Migros'tan yazılı izin ve API belgesi alınmadan ÇALIŞMAZ
MIGROS_MODE=off
MIGROS_PARTNER_BASE_URL=
MIGROS_PARTNER_API_KEY=
