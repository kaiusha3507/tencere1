{
  "expo": {
    "name": "Tencere",
    "slug": "tencere",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tencere",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C8432B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ornek.tencere"
    },
    "android": {
      "package": "com.ornek.tencere",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C8432B"
      }
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
